<?xml version="1.0" encoding="utf-8"?>
<!--
  极风工具箱 启动图标背景
  小米风格: 橙色渐变 (#FF6900 → #FF8800 → #E65100)
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp" android:height="108dp"
    android:viewportWidth="108" android:viewportHeight="108">

    <!-- 主背景渐变 -->
    <path android:fillColor="#FF6900"
        android:pathData="M0,0h108v108h-108z"/>

    <!-- 径向高光 (左上偏亮, 模拟小米品牌质感) -->
    <path android:fillColor="#FF8800" android:fillAlpha="0.6"
        android:pathData="M0,0h108v54h-108z"/>

    <!-- 底部暗角 -->
    <path android:fillColor="#E65100" android:fillAlpha="0.4"
        android:pathData="M0,72h108v36h-108z"/>
</vector>
