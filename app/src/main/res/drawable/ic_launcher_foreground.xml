    <!-- 齿 0 (上) -->
    <path android:fillColor="#FFFFFF"
        android:pathData="M50,26 h8 v8 h-8 z"/>
    <!-- 齿 1 (右上) -->
    <path android:fillColor="#FFFFFF"
        android:pathData="M67.2,33.2 l5.6,5.6 l-5.6,5.6 l-5.6,-5.6 z"/>
    <!-- 齿 2 (右) -->
    <path android:fillColor="#FFFFFF"
        android:pathData="M74,50 h8 v8 h-8 z"/>
    <!-- 齿 3 (右下) -->
    <path android:fillColor="#FFFFFF"
        android:pathData="M67.2,67.2 l5.6,-5.6 l5.6,5.6 l-5.6,5.6 z"/>
    <!-- 齿 4 (下) -->
    <path android:fillColor="#FFFFFF"
        android:pathData="M50,74 h8 v8 h-8 z"/>
    <!-- 齿 5 (左下) -->
    <path android:fillColor="#FFFFFF"
        android:pathData="M35.2,69.2 l5.6,-5.6 l5.6,5.6 l-5.6,5.6 z"/>
