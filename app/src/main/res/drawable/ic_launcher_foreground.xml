<?xml version="1.0" encoding="utf-8"?>
<!--
  极风工具箱 启动图标前景
  卡通"极风小狐狸"形象 (品牌橙 + 白 + 深色点缀)
  安全区域: 中心 36x36 (viewport 36~72), 中心点 (54,54)
  设计: 圆脑袋 + 两只尖耳朵 + 白色脸颊下巴 + 黑眼睛 + 小三角鼻 + 微笑
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp" android:height="108dp"
    android:viewportWidth="108" android:viewportHeight="108">

    <!-- ===== 耳朵 (外层, 品牌橙 #FF6B35) ===== -->
    <!-- 左耳: 尖朝上 -->
    <path android:fillColor="#FF6B35"
        android:pathData="M39,48 L42,36 L50,46 Z"/>
    <!-- 右耳: 尖朝上 -->
    <path android:fillColor="#FF6B35"
        android:pathData="M58,46 L66,36 L69,48 Z"/>

    <!-- ===== 耳朵内侧 (深橙阴影 #E0582A, 增加层次) ===== -->
    <!-- 左耳内 -->
    <path android:fillColor="#E0582A"
        android:pathData="M42,46 L43,39 L47,45 Z"/>
    <!-- 右耳内 -->
    <path android:fillColor="#E0582A"
        android:pathData="M61,45 L65,39 L66,46 Z"/>

    <!-- ===== 头部主体 (品牌橙圆形, 中心 (54,55), 半径 15) ===== -->
    <path android:fillColor="#FF6B35"
        android:pathData="M54,55 m-15,0 a15,15 0 1,0 30,0 a15,15 0 1,0 -30,0"/>

    <!-- ===== 头顶高光 (浅橙 #FF8E53, 椭圆, 立体感) ===== -->
    <path android:fillColor="#FF8E53"
        android:pathData="M48,47 m-7,0 a7,4.5 0 1,0 14,0 a7,4.5 0 1,0 -14,0"/>

    <!-- ===== 白色脸颊 / 下巴 (白色 #FFFFFF, 包裹口鼻区域) ===== -->
    <path android:fillColor="#FFFFFF"
        android:pathData="M41,57 Q54,71 67,57 Q60,64 54,64 Q48,64 41,57 Z"/>

    <!-- ===== 眼睛 (深色 #2C2C2C, 圆形) ===== -->
    <!-- 左眼 -->
    <path android:fillColor="#2C2C2C"
        android:pathData="M47,52 m-2.6,0 a2.6,2.6 0 1,0 5.2,0 a2.6,2.6 0 1,0 -5.2,0"/>
    <!-- 右眼 -->
    <path android:fillColor="#2C2C2C"
        android:pathData="M61,52 m-2.6,0 a2.6,2.6 0 1,0 5.2,0 a2.6,2.6 0 1,0 -5.2,0"/>

    <!-- ===== 眼睛高光 (白色小点, 灵动感) ===== -->
    <!-- 左眼高光 -->
    <path android:fillColor="#FFFFFF"
        android:pathData="M47.8,51 m-0.9,0 a0.9,0.9 0 1,0 1.8,0 a0.9,0.9 0 1,0 -1.8,0"/>
    <!-- 右眼高光 -->
    <path android:fillColor="#FFFFFF"
        android:pathData="M61.8,51 m-0.9,0 a0.9,0.9 0 1,0 1.8,0 a0.9,0.9 0 1,0 -1.8,0"/>

    <!-- ===== 鼻子 (深色小三角 #2C2C2C) ===== -->
    <path android:fillColor="#2C2C2C"
        android:pathData="M52,58.5 L56,58.5 L54,61.5 Z"/>

    <!-- ===== 微笑 (深色弧线) ===== -->
    <path android:fillColor="#00000000"
        android:strokeColor="#2C2C2C"
        android:strokeWidth="1.4"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:pathData="M50.5,63.5 Q54,66.5 57.5,63.5"/>

</vector>
