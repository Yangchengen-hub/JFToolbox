    <path android:fillColor="#FFFFFF"
        android:pathData="M35.2,33.2 l5.6,5.6 l-5.6,5.6 l-5.6,-5.6 z"/>

    <!-- 齿轮主圆盘 -->
    <path android:fillColor="#FFFFFF"
        android:pathData="M54,54 m-22,0 a22,22 0 1,0 44,0 a22,22 0 1,0 -44,0"/>

    <!-- 齿轮内环 (橙色镂空, 露出背景) -->
