    <path android:fillColor="#FF6900"
        android:pathData="M64,32 L68,36 L72,32 L68,28 Z"/>

    <!-- ===== 中心 "JF" 标识 ===== -->
    <!-- J 字 -->
    <path android:fillColor="#FFFFFF"
        android:pathData="M51,45 h4 v8 a3,3 0 0,1 -6,0 v-2 h3 v2 a0,0 0 0,0 0,0 v-8 z"/>
    <!-- F 字 -->
    <path android:fillColor="#FFFFFF"
        android:pathData="M56,45 h7 v3 h-4 v2 h3 v3 h-3 v3 h-3 z"/>

