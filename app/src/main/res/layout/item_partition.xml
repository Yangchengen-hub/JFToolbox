<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="horizontal" android:padding="8dp"
    android:background="?attr/selectableItemBackground">

    <TextView android:id="@+id/txtPartName" android:layout_width="0dp" android:layout_weight="2"
        android:layout_height="wrap_content" android:textSize="13sp" android:textStyle="bold"/>
    <TextView android:id="@+id/txtPartSize" android:layout_width="0dp" android:layout_weight="1"
        android:layout_height="wrap_content" android:textSize="12sp" android:gravity="end"/>
    <TextView android:id="@+id/txtPartTag" android:layout_width="0dp" android:layout_weight="1"
        android:layout_height="wrap_content" android:textSize="11sp" android:gravity="end"/>

</LinearLayout>
