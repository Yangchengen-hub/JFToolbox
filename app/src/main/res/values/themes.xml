<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.JFToolbox" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="colorPrimary">#1A73E8</item>
        <item name="colorPrimaryDark">#1557B0</item>
        <item name="colorAccent">#34A853</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowBackground">@drawable/bg_glass</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <style name="Theme.JFToolbox.Splash" parent="Theme.JFToolbox">
        <item name="android:windowBackground">@drawable/bg_glass</item>
    </style>

    <style name="JF.FeatureCard" parent="Widget.MaterialComponents.CardView">
        <item name="cardCornerRadius">20dp</item>
        <item name="cardElevation">2dp</item>
        <item name="strokeWidth">1dp</item>
        <item name="strokeColor">#22FFFFFF</item>
        <item name="cardBackgroundColor">#CCFFFFFF</item>
    </style>
</resources>
