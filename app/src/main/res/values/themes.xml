<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.JFToolbox" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="colorPrimary">#1976D2</item>
        <item name="colorPrimaryDark">#0D47A1</item>
        <item name="colorAccent">#FF6F00</item>
        <item name="android:statusBarColor">#0D47A1</item>
        <item name="android:navigationBarColor">#0D47A1</item>
        <item name="android:windowBackground">#F5F7FA</item>
        <item name="android:textColor">#212121</item>
